config sim-time-limit 20s
config description "Fuzzy random injection attack on CAN bus"
config extends General
config *.enableFuzzy true
config *.fuzzyAttacker.attackInterval 0.5ms
config *.fuzzyAttacker.attackStartTime 5s
config *.fuzzyAttacker.attackDuration 10s
config *.alertSink.logFile "\"results/ids_alerts_fuzzy.csv\""
config network dpcrids.AutomotiveNetwork
config sim-time-limit 30s
config warmup-period 1s
config repeat 5
config seed-set 4
config *.numSensorECUs 5
config *.numAdasECUs 2
config *.enableDos false
config *.enableFuzzy false
config *.enableSpoof false
config *.sensor[*].sendInterval 2ms
config *.sensor[*].numCanIds 10
config *.sensor[*].payloadLength 8
config *.adas[*].sendInterval 1ms
config *.adas[*].payloadLength 512
config *.gateway.canExpert.onnxModelPath "\"models/can_student.onnx\""
config *.gateway.canExpert.normalizationPath "\"models/can_normalization.json\""
config *.gateway.canExpert.temperature 0.95
config *.gateway.canExpert.windowSize 100
config *.gateway.canExpert.stride 50
config *.gateway.ethExpert.onnxModelPath "\"models/eth_student.onnx\""
config *.gateway.ethExpert.temperature 0.5
config *.gateway.fusion.onnxModelPath "\"models/fusion_student.onnx\""
config *.gateway.fusion.temperature 1.1
config *.gateway.fusion.bucketMs 250
config *.gateway.router.tauLow 0.15
config *.gateway.router.tauHigh 0.85
config *.gateway.router.fallbackUncertaintyLow 0.3
config *.gateway.router.fallbackUncertaintyHigh 0.7
config *.gateway.aggregator.bucketMs 250
config *.gateway.aggregator.failOpen true
config *.alertSink.logFile "\"results/ids_alerts_general.csv\""
config output-vector-file results/Fuzzy-4.vec
config output-scalar-file results/Fuzzy-4.sca
config eventlog-file results/Fuzzy-4.elog

