config sim-time-limit 25s
config description "Combined DoS + Fuzzy + Spoof attack"
config extends General
config *.enableDos true
config *.enableFuzzy true
config *.enableSpoof true
config *.dosAttacker.attackStartTime 3s
config *.dosAttacker.attackDuration 5s
config *.fuzzyAttacker.attackStartTime 8s
config *.fuzzyAttacker.attackDuration 5s
config *.spoofAttacker.attackStartTime 14s
config *.spoofAttacker.attackDuration 5s
config *.spoofAttacker.spoofType "\"gear\""
config *.alertSink.logFile "\"results/ids_alerts_multi.csv\""
config sim-time-limit 25s
config network dpcrids.AutomotiveNetwork
config sim-time-limit 30s
config warmup-period 1s
config repeat 5
config seed-set 3
config *.numSensorECUs 5
config *.numAdasECUs 2
config *.enableDos false
config *.enableFuzzy false
config *.enableSpoof false
config *.sensor[*].sendInterval 2ms
config *.sensor[*].numCanIds 10
config *.sensor[*].payloadLength 8
