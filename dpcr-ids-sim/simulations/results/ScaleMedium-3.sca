config *.alertSink.logFile "\"results/ids_alerts_scale_med.csv\""
config network dpcrids.AutomotiveNetwork
config sim-time-limit 30s
config warmup-period 1s
config repeat 5
config seed-set 3
config *.numSensorECUs 5
config *.numAdasECUs 2
config *.enableDos false
config *.enableFuzzy false
config *.enableSpoof false
config *.sensor[*].sendInterval 2ms
config *.sensor[*].numCanIds 10
config *.sensor[*].payloadLength 8
config *.adas[*].sendInterval 1ms
config *.adas[*].payloadLength 512
config *.gateway.canExpert.onnxModelPath "\"models/can_student.onnx\""
